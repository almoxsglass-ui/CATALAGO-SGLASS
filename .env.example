# Frontend settings (Vite)
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_OIDC_AUTHORITY=https://your-oidc-issuer
VITE_OIDC_CLIENT_ID=your-oidc-client-id
VITE_OIDC_SCOPE=openid profile email
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback

# Convex backend authentication settings.
# OIDC_ISSUER_URL must exactly match the token's "iss" claim.
# OIDC_APPLICATION_ID must exactly match the token's "aud" claim.
OIDC_ISSUER_URL=https://your-oidc-issuer
OIDC_APPLICATION_ID=your-oidc-audience
